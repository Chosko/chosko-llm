{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf 'PROBE-SESSIONSTART %s remote=%s entry=%s\\n' \"$(date -u +%FT%TZ)\" \"${CLAUDE_CODE_REMOTE:-unset}\" \"${CLAUDE_CODE_ENTRYPOINT:-unset}\" | tee -a /tmp/hook-probe.log"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "printf 'PROBE-PRETOOLUSE %s remote=%s\\n' \"$(date -u +%FT%TZ)\" \"${CLAUDE_CODE_REMOTE:-unset}\" >> /tmp/hook-probe.log 2>/dev/null; exit 0"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ask-gate.sh\""
          }
        ]
      }
    ]
  }
}
